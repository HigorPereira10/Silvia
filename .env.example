# Copie este arquivo para .env e ajuste os valores.

# Porta HTTP do servidor (API REST, WebSocket e front-end)
PORTA=3000

# Segredo usado para assinar os tokens JWT. Troque em produção!
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRACAO=8h

# Caminho do arquivo SQLite (use :memory: para um banco temporário)
BANCO_ARQUIVO=data/silvia.db

# Pasta onde as evidências enviadas são guardadas
PASTA_UPLOADS=uploads

# Hora (0-23) em que o ciclo diário de decaimento das plantas roda
CICLO_DIARIO_HORA=0


# URL do web service externo de CEP
VIACEP_URL=https://viacep.com.br/ws
