{
  "name": "silvia",
  "version": "1.0.0",
  "description": "Silvia: plataforma gamificada de apoio ao Sistema de Gestão Ambiental (ISO 14001) baseada em Web Services REST e WebSocket.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "db:migrar": "node --disable-warning=ExperimentalWarning src/database/migrar.js",
    "db:seed": "node --disable-warning=ExperimentalWarning src/database/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:cobertura": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --experimental-test-coverage \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "keywords": [
    "iso-14001",
    "web-services",
    "rest",
    "websocket",
    "gamificacao",
    "aps",
    "unip"
  ],
  "author": "Higor, Breno e João",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.1.4"
  }
}
